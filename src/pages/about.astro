---
import Logo from '../components/Logo.astro';
import ProfilePhoto from '../components/ProfilePhoto.astro';
import TechChip from '../components/TechChip.astro';
import TechIcon from '../components/TechIcon.astro';
import { about, aboutFacts, aboutText, aiTools, companies, enginesFrameworks, focusAreas, programmingLanguages } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';

const { basedIn, education, languages, experience } = aboutFacts;
---

<BaseLayout title="About" description={aboutText}>
  <div class="about">
    <div class="about__photo enter" style="--i: 0">
      <ProfilePhoto />
    </div>

    <!-- Facts card and groups card: 4 rows each. ≥1024 both cards sit on one shared 4-row grid
         (subgrid), so their dividers are always on the same lines. -->
    <div class="about__cards">
      <ul class="card about-card facts enter" style="--i: 3" aria-label="Facts">
        <li class="about-card__row">
          <div class="fact">
            <span class="fact__tile" aria-hidden="true"><TechIcon name={basedIn.icon} size={18} /></span>
            <div class="fact__body">
              <span class="fact__label">{basedIn.label}</span>
              <span class="fact__value">
                <TechIcon name={basedIn.flag} size={20} flag />
                {basedIn.value}
              </span>
            </div>
          </div>
        </li>
        <li class="about-card__row">
          <div class="fact">
            <span class="fact__tile fact__tile--logo" aria-hidden="true"><Logo slug={education.logo} size={40} class="fact__logo" /></span>
            <div class="fact__body">
              <span class="fact__label">{education.label}</span>
              <span class="fact__value">{education.value}</span>
              <span class="fact__note">{education.detail}</span>
            </div>
          </div>
        </li>
        <li class="about-card__row">
          <div class="fact">
            <span class="fact__tile" aria-hidden="true"><TechIcon name={languages.icon} size={18} /></span>
            <div class="fact__body">
              <span class="fact__label">{languages.label}</span>
              <ul class="fact__value fact__langs">
                {
                  languages.items.map((name) => (
                    <li class="fact__lang">
                      <TechIcon name={name} size={16} flag />
                      {name}
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </li>
        <li class="about-card__row">
          <div class="fact">
            <span class="fact__tile" aria-hidden="true"><TechIcon name={experience.icon} size={18} /></span>
            <div class="fact__body">
              <span class="fact__label">{experience.label}</span>
              <span class="fact__value">{experience.value}</span>
              <span class="fact__note">
                <span class="fact__logos" aria-hidden="true">
                  {companies.map((company) => <Logo slug={company.logo} size={24} class="fact__stack-logo" />)}
                </span>
                {companies.length} studios
              </span>
            </div>
          </div>
        </li>
      </ul>

      <div class="card about-card groups enter" style="--i: 4">
        {
          [
            { id: 'focus', label: 'Focus Areas', items: focusAreas, icons: false },
            { id: 'languages', label: 'Programming Languages', items: programmingLanguages, icons: true },
            { id: 'engines', label: 'Engines & Frameworks', items: enginesFrameworks, icons: true },
            { id: 'ai', label: 'AI Tools', items: aiTools, icons: true },
          ].map((group) => (
            <section class="about-card__row group" aria-labelledby={`${group.id}-title`}>
              <div class="group__inner">
                <h2 id={`${group.id}-title`} class="label group__label">
                  {group.label}
                </h2>
                <ul class="pill-list">
                  {group.items.map((item) => (group.icons ? <TechChip name={item} /> : <li class="chip">{item}</li>))}
                </ul>
              </div>
            </section>
          ))
        }
      </div>
    </div>

    <div class="about__intro">
      <h1 class="page-title enter" style="--i: 1">About Me</h1>
      <div class="about__text enter" style="--i: 2">
        {about.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>

    <div class="btn-row about__actions">
      <a class="btn btn--primary" href={withBase('resume/')}>Resume</a>
      <a class="btn btn--secondary" href={withBase('contact/')}>Contact</a>
    </div>
  </div>
</BaseLayout>

<style>
  /* ≥1280: photo beside the intro; facts and groups cards share one row (equal height). */
  .about {
    display: grid;
    grid-template-columns: 352px minmax(0, 1fr);
    grid-template-areas:
      'photo intro'
      'facts groups'
      '. actions';
    gap: 24px 36px;
    padding: 72px 0 88px;
  }

  /* The photo fills its cell, so its bottom lines up with the end of the intro text. */
  .about__photo {
    position: relative;
    grid-area: photo;
    min-height: 440px;
  }

  .about__photo :global(.photo) {
    position: absolute;
    inset: 0;
  }

  /* ---------- Facts and groups cards ----------
     Each card: padding 0 20, 4 rows (min 84px, 16px vertical padding, 1px divider, content
     centred vertically). ≥1024 the wrapper is a 2-column subgrid with 4 shared rows and each
     card a row subgrid, so both cards' dividers sit on the same lines whatever the content.
     Below 1024 the wrapper disappears (display: contents) and each card is a flex column. */
  .about__cards {
    display: grid;
    grid-column: 1 / -1;
    grid-row: 2;
    grid-template-columns: subgrid;
    grid-template-rows: repeat(4, minmax(84px, auto));
    row-gap: 0;
  }

  .about-card {
    display: grid;
    grid-row: 1 / -1;
    grid-template-rows: subgrid;
    min-width: 0;
    padding: 0 20px;
  }

  .facts {
    grid-column: 1;
  }

  .groups {
    grid-column: 2;
  }

  .about-card__row {
    display: flex;
    align-items: center;
    min-width: 0;
    min-height: 84px;
    padding: 16px 0;
  }

  .about-card__row + .about-card__row {
    border-top: 1px solid var(--line);
  }

  /* Fact row: 40px tile | label → value → optional muted line. */
  .fact {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 14px;
    align-items: start;
    width: 100%;
  }

  .fact__tile {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    overflow: hidden;
    border-radius: 10px;
    background: var(--chip);
    color: var(--text);
  }

  .fact__tile--logo :global(.fact__logo) {
    width: 40px;
    height: 40px;
    border-radius: 10px;
  }

  .fact__body {
    min-width: 0;
  }

  .fact__label {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .fact__value {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    font-size: 15px;
    font-weight: 500;
    line-height: 22px;
  }

  .fact__note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 2px;
    font-size: 13px;
    line-height: 20px;
    color: var(--muted);
  }

  /* Languages: inline items (16px flag + name), no chip backgrounds. */
  .fact__langs {
    gap: 4px 10px;
  }

  .fact__lang {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 14px;
    white-space: nowrap;
  }

  /* Overlapping company logos: 24px, radius 7, 2px surface ring, −6px overlap. */
  .fact__logos {
    display: inline-flex;
    align-items: center;
  }

  .fact__logos :global(.fact__stack-logo) {
    box-sizing: border-box;
    border: 2px solid var(--surface);
    border-radius: 7px;
  }

  .fact__logos :global(.fact__stack-logo + .fact__stack-logo) {
    margin-left: -6px;
  }

  .group__inner {
    width: 100%;
  }

  .group__label {
    display: block;
    margin-bottom: 12px;
  }

  /* ---------- Intro ---------- */
  .about__intro {
    display: flex;
    grid-area: intro;
    flex-direction: column;
    gap: 20px;
  }

  /* Three paragraphs, 14px apart. */
  .about__text {
    font-size: 20px;
    line-height: 1.6;
  }

  .about__text p + p {
    margin-top: 14px;
  }

  .about__actions {
    grid-area: actions;
    justify-content: flex-end;
  }

  /* 1024–1279 */
  @media (max-width: 1279.98px) {
    .about {
      grid-template-columns: 344px minmax(0, 1fr);
    }

    .about__text {
      font-size: 18px;
    }
  }

  /* 640–1023: photo and facts side by side, everything else full width. */
  @media (max-width: 1023.98px) {
    .about {
      grid-template-columns: 260px minmax(0, 1fr);
      grid-template-areas:
        'photo facts'
        'intro intro'
        'groups groups'
        'actions actions';
      padding: 48px 0 64px;
    }

    .about__photo {
      position: static;
      min-height: 0;
    }

    .about__photo :global(.photo) {
      position: static;
    }

    .about__photo :global(.photo__img) {
      height: auto;
      aspect-ratio: 4 / 5;
    }

    /* The wrapper steps aside; each card takes its own area and is a flex column of 4 equal
       rows. */
    .about__cards {
      display: contents;
    }

    .about-card {
      display: flex;
      flex-direction: column;
      grid-row: auto;
      grid-column: auto;
    }

    .facts {
      grid-area: facts;
    }

    .groups {
      grid-area: groups;
    }

    .about-card__row {
      flex: 1;
    }
  }

  /* < 640: single column, large rectangular photo. */
  @media (max-width: 639.98px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'photo'
        'facts'
        'intro'
        'groups'
        'actions';
      row-gap: 20px;
      padding: 24px 0 48px;
    }

    .about__photo :global(.photo__img) {
      max-height: 480px;
    }

    .about__text {
      font-size: 17px;
    }

    .about-card {
      padding: 0 16px;
    }

    /* Label → chips: the shared --label-gap, minus the label's lower half-leading. */
    .group__label {
      margin-bottom: calc(var(--label-gap) - (1lh - 1.3em) / 2);
    }
  }
</style>
