---
// One page per visible project at /projects/<slug>/:
//   · Case Study — the full case study layout;
//   · Demo — a simple page with the same content as the project sheet (the no-JS fallback for
//     demo cards; with JavaScript the cards open the sheet instead).
// Prev / next cycle within the project's own kind (6 case studies, 5 demos), wrapping around —
// in the nav bar and in "More" (the first project's Previous is the last one, and vice versa).
import DemoContent from '../../components/DemoContent.astro';
import Icon from '../../components/Icon.astro';
import ImageViewer from '../../components/ImageViewer.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ProjectHero from '../../components/ProjectHero.astro';
import type { Project } from '../../data/personal';
import { personalProjects } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/paths';
import { kindLabel, metaLine, positionIn, projectUrl, siblingsOf, visibleProjects } from '../../utils/personal';

export function getStaticPaths() {
  return visibleProjects.map((project) => {
    const list = siblingsOf(project);
    const index = list.findIndex((other) => other.slug === project.slug);
    return {
      params: { slug: project.slug },
      props: {
        project,
        prev: list[(index - 1 + list.length) % list.length],
        next: list[(index + 1) % list.length],
      },
    };
  });
}

interface Props {
  project: Project;
  prev: Project;
  next: Project;
}

const { project, prev, next } = Astro.props;
const { media } = project;
const isCaseStudy = project.detailLevel === 'case-study';
const kind = kindLabel(project);
const position = positionIn(siblingsOf(project), project);
const backHref = withBase(`/#${personalProjects.id}`);
const hasCycle = prev.slug !== project.slug;

// "More": the previous and next project in the Work order (newest first), wrapping around, as Work
// cards. With only two projects of a kind both would be the same one, so it is shown once (Next).
const more = hasCycle
  ? [
      ...(prev.slug !== next.slug ? [{ other: prev, rel: 'prev' as const, label: 'Previous' }] : []),
      { other: next, rel: 'next' as const, label: 'Next' },
    ]
  : [];
---

<BaseLayout
  title={project.title}
  description={project.description}
  image={`media/personal/${project.slug}/${media.cover.src}`}
  imageAlt={`${project.title} — ${metaLine(project)}`}
>
  <article class:list={['case', { 'case--demo': !isCaseStudy }]}>
    <nav class="case__bar enter" style="--i: 0" aria-label={isCaseStudy ? 'Case studies' : 'Demos'}>
      <div class="case__path">
        <a class="case__btn" href={backHref}>
          <Icon name="arrow-left" size={16} />
          All projects
        </a>
        <ol class="case__trail">
          <li><a href={withBase('/')}>Work</a></li>
          <li class="case__trail-sep" aria-hidden="true"><Icon name="chevron-right" size={12} /></li>
          <li><a href={backHref}>{personalProjects.title}</a></li>
          <li class="case__trail-sep" aria-hidden="true"><Icon name="chevron-right" size={12} /></li>
          <li class="case__trail-here" aria-current="page">{project.title}</li>
        </ol>
      </div>
      {
        hasCycle && (
          <div class="case__pn">
            <span class="case__pos">
              {kind} {position.index} of {position.total}
            </span>
            <a class="case__btn case__btn--icon" href={projectUrl(prev)} rel="prev" aria-label={`Previous ${kind.toLowerCase()}: ${prev.title}`}>
              <Icon name="chevron-left" />
            </a>
            <a class="case__btn case__btn--icon" href={projectUrl(next)} rel="next" aria-label={`Next ${kind.toLowerCase()}: ${next.title}`}>
              <Icon name="chevron-right" />
            </a>
          </div>
        )
      }
    </nav>

    {
      isCaseStudy ? (
        <>
          <ProjectHero project={project} class="case__hero enter" style="--i: 1" />

          <ProjectGallery project={project} idPrefix="case" class="case__gallery enter" style="--i: 2" />

        </>
      ) : (
        <div class="case__demo enter" style="--i: 1">
          <DemoContent project={project} idPrefix="page" headingLevel="h1" />
        </div>
      )
    }

    {more.length > 0 && (
      <section class="case__more" aria-labelledby="case-more">
        <h2 class="case__more-title" id="case-more">
          More
        </h2>
        <ul class="case__more-grid">
          {more.map(({ other, rel, label }) => (
            <li class:list={['case__more-item', `case__more-item--${rel}`]}>
              <span class="label case__more-label" aria-hidden="true">
                {rel === 'prev' && <Icon name="arrow-left" size={12} />}
                {label}
                {rel === 'next' && <Icon name="arrow-right" size={12} />}
              </span>
              <ProjectCard project={other} rel={rel} opensSheet={false} />
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>

  <ImageViewer />
</BaseLayout>

<style>
  /* ---------- Vertical rhythm ----------
     --gap-lg 40px (32 on phones): nav border → eyebrow, hero → player, section borders and
     paddings, last content → footer border. */
  .case {
    --gap-lg: 40px;

    display: flex;
    flex-direction: column;
    padding-bottom: var(--gap-lg);
  }

  /* The page ends exactly --gap-lg above the footer's border (the footer's own top margin is
     dropped on project pages). */
  :global(main:has(.case) + .site-footer) {
    margin-top: 0;
  }

  /* ---------- Nav bar under the site header ---------- */
  .case__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  .case__path,
  .case__pn {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .case__pn {
    flex: none;
    gap: 8px;
  }

  /* 40px buttons; ::before widens the hit area to 44px. */
  .case__btn {
    position: relative;
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 40px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    white-space: nowrap;
    transition:
      opacity 0.15s ease,
      border-color 200ms ease;
  }

  .case__btn::before {
    content: '';
    position: absolute;
    inset: -3px;
  }

  .case__btn:hover {
    opacity: 1;
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
  }

  .case__btn--icon {
    width: 40px;
    padding: 0;
  }

  /* Breadcrumb: "Work › Personal Projects › Title" with 12px chevrons and 8px gaps. */
  .case__trail {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    font-size: 14px;
    line-height: 20px;
    color: var(--muted);
    white-space: nowrap;
  }

  .case__trail li {
    display: flex;
    flex: none;
    align-items: center;
  }

  .case__trail a {
    color: var(--muted);
    transition: color 200ms ease;
  }

  .case__trail a:hover {
    opacity: 1;
    color: var(--accent);
  }

  .case__trail-sep {
    color: var(--muted);
  }

  .case__trail .case__trail-here {
    display: block;
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    font-weight: 500;
    color: var(--text);
    text-overflow: ellipsis;
  }

  /* "Case Study 1 of 6" never wraps or shrinks. */
  .case__pos {
    flex: none;
    margin-right: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
  }

  /* ---------- Start section (nav border → eyebrow 40), then the Gallery (details card →
     border 40, border → head 40, like "More") ---------- */
  .case :global(.case__hero),
  .case :global(.case__gallery),
  .case__demo {
    margin-top: var(--gap-lg);
  }

  /* ---------- More: divider, 40 to the h2, h2 → cards 24 ---------- */
  .case__more {
    margin-top: var(--gap-lg);
    padding-top: var(--gap-lg);
    border-top: 1px solid var(--line);
  }

  .case__more-title {
    margin-bottom: 24px;
    font-size: 22px;
    line-height: 28px;
  }

  /* ≥640: two equal columns filling the row, with the Work grid's gaps (24 ≥1024, 20 below).
     Previous always sits in the left column and Next in the right, so a lone neighbour keeps
     its side. < 640: one column. */
  .case__more-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .case__more-item--prev {
    grid-column: 1;
  }

  .case__more-item--next {
    grid-column: 2;
  }

  .case__more-item {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  /* "← Previous" on the card's left edge, "Next →" on its right edge. */
  .case__more-label {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 6px;
    line-height: 16px;
  }

  .case__more-item--next .case__more-label {
    align-self: flex-end;
  }

  .case__more-item > :global(.project-card) {
    flex: 1;
    height: auto;
  }

  /* 640–1023 */
  @media (max-width: 1023.98px) {
    .case__more-grid {
      gap: 20px;
    }
  }

  /* < 640 */
  @media (max-width: 639.98px) {
    .case {
      --gap-lg: 32px;
    }

    .case__trail,
    .case__pos {
      display: none;
    }

    .case__more-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    .case__more-item--prev,
    .case__more-item--next {
      grid-column: 1;
    }
  }
</style>
