---
import CompanyAccordion from '../components/CompanyAccordion.astro';
import HeroStats from '../components/HeroStats.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { featuredProjects } from '../data/projects';
import { personalProjects, profile } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';
import { commercialProjectsText } from '../utils/projects';
---

<BaseLayout>
  <section class="hero">
    <div class="hero__text">
      <h1 class="hero__title hero-enter" style="--i: 0">{profile.heroHeadline}</h1>
      <p class="hero__intro hero-enter" style="--i: 1">{profile.heroIntro}</p>
      <div class="btn-row hero__actions hero-enter" style="--i: 2">
        <a class="btn btn--primary" href="#work">Explore</a>
        <a class="btn btn--secondary" href={withBase(profile.cvPath)} download>Download CV</a>
      </div>
    </div>

    <HeroStats />
  </section>

  {
    featuredProjects.length > 0 && (
      <section class="section" aria-labelledby="selected-title">
        <div class="section-head">
          <h2 id="selected-title">Selected work</h2>
        </div>
        <div class="selected__grid">
          {featuredProjects.map((project) => (
            <ProjectCard {...project} />
          ))}
        </div>
      </section>
    )
  }

  <section id="work" class="section" aria-labelledby="work-title">
    <div class="section-head">
      <h2 id="work-title">Commercial Projects</h2>
      <span class="section__count">{commercialProjectsText()}</span>
    </div>
    <CompanyAccordion />
  </section>

  <section id={personalProjects.id} class="section" aria-labelledby="personal-title">
    <div class="section-head">
      <h2 id="personal-title">{personalProjects.title}</h2>
      <span class="section__count">{personalProjects.projectCount} projects</span>
    </div>
    <p class="section__about">{personalProjects.about}</p>
    {/* TODO (next phase): personal project cards go here, replacing the note below. */}
    <p class="pending-note">Project videos and details are being added.</p>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center;
    gap: 56px;
    padding: 88px 0;
  }

  .hero__title {
    font-size: 60px;
    line-height: 1.04;
    letter-spacing: -0.03em;
  }

  .hero__intro {
    max-width: 560px;
    margin-top: 24px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--muted);
  }

  .hero__actions {
    margin-top: 36px;
  }

  /* Page load only: headline, intro and buttons rise in, 110ms apart (the cards follow,
     see HeroStats). After a navigation the page transition brings them in instead. */
  :global(main[data-entrance='first']) .hero-enter {
    animation: rise 720ms var(--ease-out) backwards;
    animation-delay: calc(80ms + var(--i) * 110ms);
  }

  /* ---------- Sections ---------- */
  .section {
    padding-bottom: 72px;
  }

  .section__count {
    flex: none;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }

  .section__about {
    margin: 18px 0 16px;
    font-size: 15px;
    color: var(--muted);
  }

  .selected__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 20px;
    margin-top: 24px;
  }

  /* 1024–1279 */
  @media (max-width: 1279.98px) {
    .hero__title {
      font-size: 52px;
    }
  }

  /* 640–1023: single column, stat cards become a compact row under the buttons. */
  @media (max-width: 1023.98px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      padding: 56px 0;
    }

    .hero__title {
      font-size: 44px;
    }

    .hero__intro {
      max-width: none;
    }
  }

  /* < 640 */
  @media (max-width: 639.98px) {
    .hero {
      gap: 24px;
      padding: 36px 0 44px;
    }

    .hero__title {
      font-size: 36px;
    }

    .hero__intro {
      margin-top: 16px;
      font-size: 16px;
    }

    .hero__actions {
      margin-top: 24px;
    }

    .section {
      padding-bottom: 48px;
    }

    .section__about {
      font-size: 14px;
    }
  }
</style>
