---
import CvButton from '../components/CvButton.astro';
import CompanyAccordion from '../components/CompanyAccordion.astro';
import HeroStats from '../components/HeroStats.astro';
import ImageViewer from '../components/ImageViewer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectLightbox from '../components/ProjectLightbox.astro';
import { featuredProjects } from '../data/projects';
import { personalProjects, profile } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { demoProjects, visibleProjects } from '../utils/personal';
import { commercialProjectsText, projectsText } from '../utils/projects';
---

<BaseLayout>
  <section class="hero">
    <div class="hero__text">
      <h1 class="hero__title hero-enter" style="--i: 0">{profile.heroHeadline}</h1>
      <p class="hero__intro hero-enter" style="--i: 1">{profile.heroIntro}</p>
      <div class="btn-row hero__actions hero-enter" style="--i: 2">
        <a class="btn btn--primary" href="#work">Explore</a>
        <CvButton variant="secondary" icon={false} stack />
      </div>
    </div>

    <HeroStats />
  </section>

  {
    featuredProjects.length > 0 && (
      <section class="section" aria-labelledby="selected-title">
        <div class="section-head">
          <h2 id="selected-title">Selected Work</h2>
        </div>
        <div class="selected__grid">
          {featuredProjects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>
    )
  }

  <section id="work" class="section" aria-labelledby="work-title">
    <div class="section-head">
      <h2 id="work-title">Commercial Projects</h2>
      <span class="section__count">{commercialProjectsText()}</span>
    </div>
    <CompanyAccordion />
  </section>

  <section id={personalProjects.id} class="section" aria-labelledby="personal-title">
    <div class="section-head">
      <h2 id="personal-title">{personalProjects.title}</h2>
      <span class="section__count">{projectsText(personalProjects)}</span>
    </div>
    <div class="section__sub">
      <p class="section__about">{personalProjects.about}</p>
      {/* The filter only appears with JavaScript; without it every project is shown ("All"). */}
      <div class="seg filters" role="group" aria-label="Filter projects" hidden data-project-filters>
        {
          [
            { key: 'all', label: 'All' },
            { key: 'case-study', label: 'Case Studies' },
            { key: 'card', label: 'Demos' },
          ].map(({ key, label }) => (
            <button type="button" class="seg__item" aria-pressed={key === 'all' ? 'true' : 'false'} data-filter={key}>
              {label}
            </button>
          ))
        }
      </div>
    </div>
    <ul class="projects-grid" data-project-grid>
      {
        visibleProjects.map((project) => (
          <li data-kind={project.detailLevel}>
            <ProjectCard project={project} />
          </li>
        ))
      }
    </ul>
  </section>

  <ProjectLightbox projects={demoProjects} />
  <ImageViewer />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center;
    gap: 56px;
    padding: 88px 0;
  }

  .hero__title {
    font-size: 60px;
    line-height: 1.04;
    letter-spacing: -0.03em;
  }

  .hero__intro {
    max-width: 560px;
    margin-top: 24px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--muted);
  }

  .hero__actions {
    margin-top: 36px;
  }

  /* Page load only: headline, intro and buttons rise in, 110ms apart (the cards follow,
     see HeroStats). After a navigation the page transition brings them in instead. */
  :global(main[data-entrance='first']) .hero-enter {
    animation: rise 720ms var(--ease-out) backwards;
    animation-delay: calc(80ms + var(--i) * 110ms);
  }

  /* ---------- Sections ---------- */
  .section {
    padding-bottom: 72px;
  }

  .section__count {
    flex: none;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }

  .section__about {
    margin: 18px 0 16px;
    font-size: 15px;
    color: var(--muted);
  }

  .selected__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 20px;
    margin-top: 24px;
  }

  /* Personal projects: 3 columns ≥1024, 2 at 640–1023, 1 below. */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 24px;
  }

  .projects-grid > li {
    display: flex;
    min-width: 0;
  }

  .projects-grid > li[hidden] {
    display: none;
  }

  .projects-grid > li > :global(.project-card) {
    flex: 1;
  }

  /* Description left, filter right; the filter wraps under it on narrow screens. */
  .section__sub {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin: 18px 0 24px;
  }

  .section__sub .section__about {
    margin: 0;
  }

  .filters[hidden] {
    display: none;
  }

  .section__sub + .projects-grid {
    margin-top: 0;
  }

  @media (max-width: 1023.98px) {
    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
  }

  @media (max-width: 639.98px) {
    .projects-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
  }

  /* 1024–1279 */
  @media (max-width: 1279.98px) {
    .hero__title {
      font-size: 52px;
    }
  }

  /* 640–1023: single column, stat cards become a compact row under the buttons. */
  @media (max-width: 1023.98px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      padding: 56px 0;
    }

    .hero__title {
      font-size: 44px;
    }

    .hero__intro {
      max-width: none;
    }
  }

  /* < 640 */
  @media (max-width: 639.98px) {
    .hero {
      gap: 24px;
      padding: 36px 0 44px;
    }

    .hero__title {
      font-size: 36px;
    }

    .hero__intro {
      margin-top: 16px;
      font-size: 16px;
    }

    .hero__actions {
      margin-top: 24px;
    }

    .section {
      padding-bottom: 48px;
    }

    .section__about {
      font-size: 14px;
    }
  }
</style>

<script>
  // Personal projects filter: All / Case Studies / Demos. Cards are only hidden, never
  // reordered, so the grid keeps its order and columns.
  type Filters = HTMLElement & { filtersReady?: boolean };

  function initFilters() {
    const filters = document.querySelector<Filters>('[data-project-filters]');
    const grid = document.querySelector<HTMLElement>('[data-project-grid]');
    if (!filters || !grid || filters.filtersReady) return;
    filters.filtersReady = true;
    filters.hidden = false;

    const chips = Array.from(filters.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        const filter = chip.dataset.filter ?? 'all';
        chips.forEach((other) => other.setAttribute('aria-pressed', String(other === chip)));
        grid.querySelectorAll<HTMLElement>(':scope > li').forEach((item) => {
          item.hidden = filter !== 'all' && item.dataset.kind !== filter;
        });
      }),
    );
  }

  initFilters();
  document.addEventListener('astro:page-load', initFilters);
</script>
