---
import type { FeaturedProject } from '../data/projects';

type Props = FeaturedProject;

const { title, company, type } = Astro.props;
---

<article class="card project-card">
  {/* TODO (next phase): cover image / preview loop goes in the media area. */}
  <div class="project-card__media" aria-hidden="true"></div>
  <div class="project-card__body">
    <h3 class="project-card__title">{title}</h3>
    <div class="project-card__tags">
      <span class="chip">{company}</span>
      <span class="project-card__type">{type}</span>
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .project-card__media {
    aspect-ratio: 4 / 5;
    background: var(--media);
  }

  .project-card__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px;
  }

  .project-card__title {
    font-size: 17px;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .project-card__tags .chip {
    padding: 4px 10px;
    font-size: 12px;
  }

  .project-card__type {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
</style>
