---
import Icon from './Icon.astro';
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to dark mode">
  <span class="theme-toggle__moon"><Icon name="moon" /></span>
  <span class="theme-toggle__sun"><Icon name="sun" /></span>
</button>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex: none;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-btn);
    background: var(--surface);
    color: var(--text);
  }

  .theme-toggle :global(svg) {
    transition: transform 260ms var(--ease-out);
  }

  @media (hover: hover) {
    .theme-toggle:hover :global(svg) {
      transform: rotate(25deg);
    }
  }

  /* Show the moon in light mode (switch to dark) and the sun in dark mode. */
  .theme-toggle__sun {
    display: none;
  }

  :global([data-theme='dark']) .theme-toggle__moon {
    display: none;
  }

  :global([data-theme='dark']) .theme-toggle__sun {
    display: block;
  }
</style>

<script>
  const STORAGE_KEY = 'theme';
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function readSaved(): string | null {
    try {
      return localStorage.getItem(STORAGE_KEY);
    } catch {
      return null;
    }
  }

  function apply(theme: 'light' | 'dark') {
    root.dataset.theme = theme;
    const label = theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode';
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
      button.setAttribute('aria-label', label);
    });
  }

  apply(root.dataset.theme === 'dark' ? 'dark' : 'light');

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      try {
        localStorage.setItem(STORAGE_KEY, next);
      } catch {
        // Storage unavailable (private mode, blocked): the choice lasts for this visit only
        // (client-side navigations carry it over, see BaseLayout).
      }

      // A 320ms crossfade of the whole page where supported; instant otherwise.
      if (!document.startViewTransition || reducedMotion.matches) {
        apply(next);
        return;
      }
      root.classList.add('vt-theme');
      const transition = document.startViewTransition(() => apply(next));
      transition.finished.finally(() => root.classList.remove('vt-theme'));
    });
  });

  // Follow OS changes until the visitor makes an explicit choice.
  media.addEventListener('change', (event) => {
    const saved = readSaved();
    if (saved !== 'light' && saved !== 'dark') apply(event.matches ? 'dark' : 'light');
  });
</script>
