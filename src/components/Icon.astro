---
// Small stroke icons used across the site. Always decorative (aria-hidden).
interface Props {
  name:
    | 'moon'
    | 'sun'
    | 'chevron'
    | 'download'
    | 'play'
    | 'close'
    | 'arrow-left'
    | 'arrow-right'
    | 'external'
    | 'arrow-up-right'
    | 'check'
    | 'github'
    | 'apple'
    | 'google-play'
    | 'chevron-left'
    | 'chevron-right'
    | 'expand'
    | 'monitor'
    | 'phone'
    | 'globe'
    | 'play-rect'
    | 'link';
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'moon' && <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />}
  {
    name === 'sun' && (
      <>
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </>
    )
  }
  {name === 'chevron' && <path d="M6 9l6 6 6-6" />}
  {name === 'download' && <path d="M12 3v12M7 10l5 5 5-5M5 21h14" />}
  {name === 'play' && <path d="M8 5.5v13l10.5-6.5z" fill="currentColor" />}
  {name === 'close' && <path d="M6 6l12 12M18 6L6 18" />}
  {name === 'arrow-left' && <path d="M19 12H5M11 6l-6 6 6 6" />}
  {name === 'arrow-right' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'external' && <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />}
  {name === 'arrow-up-right' && <path d="M7 17L17 7M8 7h9v9" />}
  {name === 'check' && <path d="M5 12.5l4.5 4.5L19 7.5" />}
  {name === 'chevron-left' && <path d="M15 6l-6 6 6 6" />}
  {name === 'chevron-right' && <path d="M9 6l6 6-6 6" />}
  {name === 'expand' && <path d="M14 4h6v6M20 4l-7 7M10 20H4v-6M4 20l7-7" />}
  {
    /* Chain link (two interlocking links), for links to related pages. */
    name === 'link' && (
      <>
        <path d="M10 13.5a4.5 4.5 0 0 0 6.36 0l3.18-3.18a4.5 4.5 0 0 0-6.36-6.36l-1.06 1.06" />
        <path d="M14 10.5a4.5 4.5 0 0 0-6.36 0l-3.18 3.18a4.5 4.5 0 0 0 6.36 6.36l1.06-1.06" />
      </>
    )
  }
  {
    /* Platform icons (line style). */
    name === 'monitor' && (
      <>
        <rect x="3" y="4" width="18" height="12" rx="2" />
        <path d="M8 20h8M12 16v4" />
      </>
    )
  }
  {
    name === 'phone' && (
      <>
        <rect x="7" y="2.5" width="10" height="19" rx="2" />
        <path d="M11 18.5h2" />
      </>
    )
  }
  {
    name === 'globe' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />
      </>
    )
  }
  {
    name === 'play-rect' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="M10.5 9.5v5l4-2.5z" />
      </>
    )
  }
  {
    /* Brand marks are filled shapes (stroke off). */
    name === 'github' && (
      <path
        fill="currentColor"
        stroke="none"
        transform="translate(4 4)"
        d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
      />
    )
  }
  {
    name === 'apple' && (
      <path
        fill="currentColor"
        stroke="none"
        d="M16.4 12.7c0-2.2 1.8-3.2 1.9-3.3-1-1.5-2.6-1.7-3.2-1.7-1.3-.1-2.6.8-3.3.8-.7 0-1.7-.8-2.8-.8-1.5 0-2.8.9-3.6 2.2-1.5 2.6-.4 6.5 1.1 8.7.7 1 1.6 2.2 2.7 2.2s1.5-.7 2.8-.7 1.7.7 2.8.7c1.2 0 1.9-1.1 2.6-2.1.8-1.2 1.2-2.4 1.2-2.4s-2.2-.9-2.2-3.6zM14.3 6.3c.6-.7 1-1.7.9-2.7-.9 0-2 .6-2.6 1.3-.6.7-1.1 1.7-.9 2.6 1 .1 2-.5 2.6-1.2z"
      />
    )
  }
  {
    name === 'google-play' && (
      <path
        fill="currentColor"
        stroke="none"
        d="M4.6 3.3c-.2.2-.3.5-.3.9v15.6c0 .4.1.7.3.9l8.7-8.7L4.6 3.3zm9.7 9.7L16.9 15.6 6.4 21.6l7.9-8.6zm0-2L6.4 2.4l10.5 6-2.6 2.6zm3.7-2.1l2.9 1.7c.8.5.8 1.3 0 1.8L18 14.1 15.3 12 18 8.9z"
      />
    )
  }
</svg>
